<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai.mapper.UserLearningProgressMapper">
    <!-- 这里写自定义SQL，没有的话留空也可以 -->
    <insert id="batchInsert">
        INSERT INTO user_learning_progress (user_id, skill_Name, knowledge_Name, score)
        VALUES
        <foreach collection="knowledgeNames" item="name" separator=",">
            (#{userId}, #{skillName}, #{name}, 0)
        </foreach>
    </insert>
</mapper>